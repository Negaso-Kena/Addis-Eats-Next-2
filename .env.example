# Set this to the public origin of the deployed app for canonical and social URLs.
# For a custom domain, use it only after it points to this app.
SITE_URL=https://addis-eats-next-45.vercel.app

# Required in production. Generate a unique value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes

# Optional: seed ~10 clearly labelled demo orders so the staff dashboard has data.
# Leave unset (or false) for a real, empty store. Demo orders vanish on restart.
SEED_DEMO_ORDERS=false
